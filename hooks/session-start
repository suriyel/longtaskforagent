#!/usr/bin/env bash
# SessionStart hook for long-task-agent plugin
# Copies init_project.py and the unified phase router (phase_route.py plus its
# sibling import deps) into the consumer project's scripts/ dir so the
# `using-long-task` router works on every session — including pre-init, where
# `long-task-init` hasn't yet populated scripts/.

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# ── Copy init_project.py to project scripts dir ──────────────────────────────
# The companion hint file tells the copied script where the plugin root is so it
# can locate and copy the helper scripts (validate_features.py etc.) correctly.
INIT_SCRIPT_SRC="${PLUGIN_ROOT}/skills/long-task-init/scripts/init_project.py"
if [ -f "$INIT_SCRIPT_SRC" ]; then
    mkdir -p "scripts"
    cp "$INIT_SCRIPT_SRC" "scripts/init_project.py"
    # Git Bash on Windows returns POSIX-style paths from `pwd`: /c/Users/...
    # Python on Windows cannot resolve these with os.path.isdir(), so convert
    # /c/Users/... → C:/Users/... before writing the hint file.
    PLUGIN_ROOT_HINT="${PLUGIN_ROOT}"
    if [[ "${PLUGIN_ROOT}" =~ ^/([a-zA-Z])/(.+) ]]; then
        PLUGIN_ROOT_HINT="${BASH_REMATCH[1]^^}:/${BASH_REMATCH[2]}"
    fi
    printf '%s' "${PLUGIN_ROOT_HINT}" > "scripts/.long-task-plugin-root"
fi

# ── Copy phase_route.py + import deps (count_pending, validate_features) ─────
# phase_route.py imports its siblings via sys.path insert, so all three must
# land together in the project's scripts/ dir.
for _ROUTER_SCRIPT in phase_route.py count_pending.py validate_features.py; do
    _SRC="${PLUGIN_ROOT}/scripts/${_ROUTER_SCRIPT}"
    if [ -f "$_SRC" ]; then
        mkdir -p "scripts"
        cp "$_SRC" "scripts/${_ROUTER_SCRIPT}"
    fi
done

# ── env-guide.md approval gate (advisory warning on session start) ───────────
# Worker Step 0 enforces the gate with a hard block. This hook only surfaces an
# early warning so the user sees pending approval state as soon as the session
# starts, rather than discovering it mid-Worker cycle.
APPROVAL_CHECK="${PLUGIN_ROOT}/scripts/check_env_guide_approval.py"
if [ -f "env-guide.md" ] && [ -f "$APPROVAL_CHECK" ]; then
    if command -v python >/dev/null 2>&1; then
        PYBIN="python"
    elif command -v python3 >/dev/null 2>&1; then
        PYBIN="python3"
    else
        PYBIN=""
    fi
    if [ -n "$PYBIN" ]; then
        APPROVAL_RC=0
        APPROVAL_OUT=$("$PYBIN" "$APPROVAL_CHECK" env-guide.md 2>&1) || APPROVAL_RC=$?
        if [ "$APPROVAL_RC" -eq 1 ]; then
            # Unapproved — warn on stderr so it's visible, but DO NOT exit non-zero
            # (hook failures would abort the session; Worker Step 0 is the hard gate).
            echo "[long-task-agent] WARNING: env-guide.md unapproved — §3/§4 modified since last approval." >&2
            echo "[long-task-agent] $APPROVAL_OUT" >&2
            echo "[long-task-agent] Worker cycles will be blocked at Step 0 until frontmatter approved_by / approved_date are updated." >&2
        fi
    fi
fi

# ── Inject Chinese (Simplified) language rule into the session ───────────────
# Emit a SessionStart hook JSON payload so that the rule is surfaced as
# `additionalContext` to the agent on every session start. Keeping the rule
# out of individual SKILL.md bodies avoids duplication (per plan MAIN-BRANCH
# Topic 5 guidance: rely on session-level injection rather than per-SKILL).
cat <<'JSON'
{
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "# 语言规则（Language Rule）\n\n与用户交互一律使用**简体中文**回复。以下内容保持英文原样，不翻译：\n- 代码标识符、函数名、变量名、字段名（如 `srs_trace`、`feature_id`）\n- 命令行示例与工具名（`Skill`、`Agent`、`Grep`、`mvn test` 等）\n- YAML frontmatter 的 `name` / `description` 字段\n- Commit message 与文件路径\n- 已成标识符的缩写：`SRS` / `FR` / `NFR` / `ATS` / `UCD` / `ST` / `TDD` / `UT` / `E2E`\n\n术语统一参考 `docs/templates/glossary.md`（若存在）。首次出现的英文专有名词可括注中文；后续直接使用既定译法。"
  }
}
JSON

exit 0

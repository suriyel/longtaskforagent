#!/usr/bin/env bash
# SessionStart hook for long-task-agent plugin
# Copies init_project.py to the consumer project so that the Init phase
# skill instruction `python scripts/init_project.py …` works out of the box.

# Note: do NOT use set -euo pipefail here.
# - set -e causes silent exit on any non-zero return, making debugging impossible
# - set -u causes "unbound variable" on empty bash arrays (bash < 4.4)
# - set -o pipefail can interact badly with process substitution
# This is a best-effort hook — partial failure should not abort the whole script.
set +e

# Diagnostic helper — all output goes to stderr so it doesn't pollute hook stdout
log() { echo "[long-task hook] $*" >&2; }

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
log "session-start running in $(pwd), plugin=$PLUGIN_ROOT"

# ── Copy init_project.py to project scripts dir ──────────────────────────────
# The companion hint file tells the copied script where the plugin root is so it
# can locate and copy the helper scripts (validate_features.py etc.) correctly.
INIT_SCRIPT_SRC="${PLUGIN_ROOT}/skills/long-task-init/scripts/init_project.py"
if [ -f "$INIT_SCRIPT_SRC" ]; then
    mkdir -p "scripts"
    cp "$INIT_SCRIPT_SRC" "scripts/init_project.py"
    # Git Bash on Windows returns POSIX-style paths from `pwd`: /c/Users/...
    # Python on Windows cannot resolve these with os.path.isdir(), so convert
    # /c/Users/... → C:/Users/... before writing the hint file.
    PLUGIN_ROOT_HINT="${PLUGIN_ROOT}"
    if [[ "${PLUGIN_ROOT}" =~ ^/([a-zA-Z])/(.+) ]]; then
        PLUGIN_ROOT_HINT="${BASH_REMATCH[1]^^}:/${BASH_REMATCH[2]}"
    fi
    printf '%s' "${PLUGIN_ROOT_HINT}" > "scripts/.long-task-plugin-root"
fi

# ── Install commit-msg hook (if .commit-conventions.json exists) ────────────
# The hook reads .commit-conventions.json at commit time and validates the
# message format. It is auto-installed every session so it survives clone,
# worktree creation, and manual deletion.
COMMIT_HOOK_SRC="${PLUGIN_ROOT}/hooks/commit-msg-hook"
if [ -f ".commit-conventions.json" ] && [ -d ".git" ] && [ -f "$COMMIT_HOOK_SRC" ]; then
    mkdir -p ".git/hooks"
    if [ -f ".git/hooks/commit-msg" ]; then
        # Check if it's already our hook (has our marker comment)
        if ! grep -q "reads .commit-conventions.json" ".git/hooks/commit-msg" 2>/dev/null; then
            # Pre-existing user hook — chain it
            mv ".git/hooks/commit-msg" ".git/hooks/commit-msg.user"
            log "renamed existing commit-msg hook → commit-msg.user (chaining)"
        fi
    fi
    if ! grep -q "reads .commit-conventions.json" ".git/hooks/commit-msg" 2>/dev/null; then
        cp "$COMMIT_HOOK_SRC" ".git/hooks/commit-msg"
        chmod +x ".git/hooks/commit-msg"
        log "installed commit-msg hook"
    fi
fi

# ── Multi-repo detection ────────────────────────────────────────────────────
# If project root is NOT a git repo but has sub-dirs with .git, generate
# repos-manifest.json so the router skill can detect the multi-repo topology.
#
# Validation: only include directories that are genuine, independent git repos:
#   1. git -C <dir> rev-parse --is-inside-work-tree  → confirms it's a real repo
#   2. git -C <dir> rev-parse --git-dir               → must be ".git" (not a
#      path like ../.git, ../.git/worktrees/X — confirms we're at the repo root,
#      not in a subdirectory or a worktree link)
if [ ! -d ".git" ]; then
    log "no .git at project root — entering multi-repo detection"
    # Phase 1: discover and validate repos into an array
    VALIDATED_REPOS=()
    while IFS= read -r gitdir; do
        # Use pwd -P (physical path) to match git's resolved-symlink paths
        candidate="$(cd "$(dirname "$gitdir")" 2>/dev/null && pwd -P)" || continue
        log "  candidate: $candidate"
        # Check 1: is it a real git working tree?
        if ! git -C "$candidate" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            log "    SKIP: not a git working tree"
            continue
        fi
        # Check 2: is this directory the repo root, not a worktree/submodule link?
        # git-dir returns ".git" ONLY at the repo root; subdirectories return
        # "../.git" or an absolute path; worktrees return a linked path.
        # This replaces the old show-toplevel string comparison which broke on
        # Windows Git Bash (pwd returns /c/Users/... vs git returns C:/Users/...).
        git_dir_val="$(git -C "$candidate" rev-parse --git-dir 2>/dev/null | tr -d '\r')" || { log "    SKIP: git-dir failed"; continue; }
        if [ "$git_dir_val" != ".git" ]; then
            log "    SKIP: git-dir is '$git_dir_val', not '.git' (worktree/submodule)"
            continue  # worktree or submodule with linked .git — skip
        fi
        VALIDATED_REPOS+=("$candidate")
        log "    OK"
    done < <(find . -maxdepth 4 -name ".git" -type d 2>/dev/null | sort)
    log "found ${#VALIDATED_REPOS[@]} validated repo(s)"

    # Phase 2: build JSON from validated repos
    PROJECT_ROOT="$(pwd -P)"
    REPOS_JSON="["
    FIRST=true
    for candidate in ${VALIDATED_REPOS[@]+"${VALIDATED_REPOS[@]}"}; do
        # Convert absolute path to relative path from project root
        repo_path="${candidate#"$PROJECT_ROOT"/}"
        repo_name="$(basename "$repo_path")"
        # Escape double quotes and backslashes for valid JSON
        repo_name="${repo_name//\\/\\\\}"
        repo_name="${repo_name//\"/\\\"}"
        repo_path="${repo_path//\\/\\\\}"
        repo_path="${repo_path//\"/\\\"}"
        if [ "$FIRST" = true ]; then FIRST=false; else REPOS_JSON="${REPOS_JSON},"; fi
        REPOS_JSON="${REPOS_JSON}{\"name\":\"${repo_name}\",\"path\":\"${repo_path}\"}"
    done
    REPOS_JSON="${REPOS_JSON}]"

    # Only write manifest if we found at least 1 validated sub-repo
    if [ "$FIRST" = false ]; then
        # Preserve existing manifest — downstream skills (long-task-multi-repo)
        # enrich it with global_srs, cross_repo_deps, etc.
        # Hook only creates the initial manifest; never overwrites an existing one.
        # To re-detect repos, delete repos-manifest.json and restart the session.
        if [ -f "repos-manifest.json" ]; then
            log "repos-manifest.json already exists — preserving (delete to re-detect)"
        else
            log "creating repos-manifest.json with $(echo "$REPOS_JSON" | grep -o '"name"' | wc -l) repo(s)"
            cat > "repos-manifest.json" <<EOFMANIFEST
{
  "detected": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "project_root_is_git": false,
  "repos": ${REPOS_JSON}
}
EOFMANIFEST
        fi

        # ── Copy init_project.py + plugin-root hint into each validated sub-repo
        # Each sub-repo runs the Init phase independently and needs its own
        # scripts/init_project.py + .long-task-plugin-root to locate and copy
        # helper scripts (validate_features.py, check_configs.py, etc.).
        if [ -f "$INIT_SCRIPT_SRC" ]; then
            for candidate in ${VALIDATED_REPOS[@]+"${VALIDATED_REPOS[@]}"}; do
                # Use relative path from project root (consistent with manifest)
                rel_path="${candidate#"$PROJECT_ROOT"/}"
                repo_scripts_dir="${rel_path}/scripts"
                mkdir -p "$repo_scripts_dir"
                cp "$INIT_SCRIPT_SRC" "$repo_scripts_dir/init_project.py"
                printf '%s' "${PLUGIN_ROOT_HINT}" > "$repo_scripts_dir/.long-task-plugin-root"
                log "  copied init_project.py → $repo_scripts_dir"
                # Install commit-msg hook if sub-repo has .commit-conventions.json
                if [ -f "${rel_path}/.commit-conventions.json" ] && [ -f "$COMMIT_HOOK_SRC" ]; then
                    mkdir -p "${rel_path}/.git/hooks"
                    if [ ! -f "${rel_path}/.git/hooks/commit-msg" ] || ! grep -q "reads .commit-conventions.json" "${rel_path}/.git/hooks/commit-msg" 2>/dev/null; then
                        cp "$COMMIT_HOOK_SRC" "${rel_path}/.git/hooks/commit-msg"
                        chmod +x "${rel_path}/.git/hooks/commit-msg"
                        log "  installed commit-msg hook → ${rel_path}"
                    fi
                fi
            done
        fi
    else
        log "no validated repos found — skipping manifest"
    fi
else
    log "project root IS a git repo — single-repo mode"
    # Project root IS a git repo — single repo mode, clean up any stale manifest
    if [ -f "repos-manifest.json" ]; then
        rm -f "repos-manifest.json"
    fi
fi

exit 0

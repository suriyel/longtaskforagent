#!/usr/bin/env bash
# commit-msg hook — reads .commit-conventions.json at runtime
# Installed by long-task-agent Init phase. Human-editable config.
# Bypass: git commit --no-verify  OR  SKIP_COMMIT_MSG_CHECK=1

# Use set -u only. Avoid set -e / pipefail — grep returns 1 on no-match,
# which silently kills the script under pipefail.
set -u

COMMIT_MSG_FILE="${1:-}"
[ -z "$COMMIT_MSG_FILE" ] && exit 0

# --- Escape hatches ---
if [ "${SKIP_COMMIT_MSG_CHECK:-0}" = "1" ]; then exit 0; fi

# --- Strip AI/tool trailers (Co-Authored-By, Signed-off-by, etc.) ---
if [ -f "$COMMIT_MSG_FILE" ]; then
    sed -i '/^[Cc]o-[Aa]uthored-[Bb]y:/d' "$COMMIT_MSG_FILE"
    sed -i '/^[Ss]igned-[Oo]ff-[Bb]y:/d' "$COMMIT_MSG_FILE"
    # Clean trailing blank lines
    sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$COMMIT_MSG_FILE"
fi

# --- Read subject line (first non-comment, non-empty line) ---
subject=""
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in '#'*) continue ;; esac
    [ -z "$line" ] && continue
    subject="$line"; break
done < "$COMMIT_MSG_FILE"

[ -z "$subject" ] && { echo "[commit-msg] ERROR: Empty commit message." >&2; exit 1; }

# --- Auto-pass merge/revert commits ---
case "$subject" in
    Merge\ *|Merge:\ *) exit 0 ;;
    Revert\ \"*)         exit 0 ;;
esac

# --- Locate config ---
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || true
[ -z "${PROJECT_ROOT:-}" ] && exit 0
CONFIG="$PROJECT_ROOT/.commit-conventions.json"
[ ! -f "$CONFIG" ] && exit 0

# --- JSON parser (handles any formatting: minified, pretty-printed, etc.) ---
CONFIG_FLAT="$(tr -d '\n\r' < "$CONFIG")"

_val() {
    echo "$CONFIG_FLAT" \
        | grep -oE "\"$1\"[ ]*:[ ]*(\"[^\"]*\"|[0-9]+|true|false|null)" \
        | head -1 | sed 's/[^:]*:[ ]*//' | tr -d '"' || true
}

_arr() {
    local match
    match=$(echo "$CONFIG_FLAT" | grep -oE "\"$1\"[ ]*:[ ]*\[[^]]*\]" | head -1) || true
    [ -z "$match" ] && return 0
    echo "$match" | sed 's/.*\[//; s/\]//' | { grep -o '"[^"]*"' || true; } | tr -d '"' | paste -sd'|' -
}

# --- Read config ---
profile=$(_val profile);               profile="${profile:-conventional-commits}"
subject_max=$(_val subject_max_length); subject_max="${subject_max:-72}"
subject_min=$(_val subject_min_length); subject_min="${subject_min:-10}"
custom_pattern=$(_val custom_pattern);  custom_pattern="${custom_pattern:-}"

prefixes=$(_arr prefix_whitelist)
prefixes="${prefixes:-feat|fix|chore|docs|refactor|test|style|perf|ci|build|revert}"
prefixes_hr=$(echo "$prefixes" | sed 's/|/ | /g')

# --- Subject length ---
subject_len=${#subject}
if [ "$subject_len" -gt "$subject_max" ]; then
    echo "" >&2
    echo "[commit-msg] REJECTED — subject too long (${subject_len}/${subject_max} chars)." >&2
    echo "" >&2
    echo "  YOUR MESSAGE:" >&2
    echo "    \"$subject\"" >&2
    echo "" >&2
    echo "  Shorten to at most ${subject_max} characters." >&2
    echo "" >&2; exit 1
fi
if [ "$subject_len" -lt "$subject_min" ]; then
    echo "" >&2
    echo "[commit-msg] REJECTED — subject too short (${subject_len}/${subject_min} chars)." >&2
    echo "" >&2
    echo "  YOUR MESSAGE:" >&2
    echo "    \"$subject\"" >&2
    echo "" >&2
    echo "  Lengthen to at least ${subject_min} characters." >&2
    echo "" >&2; exit 1
fi

# --- Rejection message with full convention spec ---
reject_conventional() {
    echo "" >&2
    echo "[commit-msg] REJECTED — message does not match project conventions." >&2
    echo "" >&2
    echo "  YOUR MESSAGE:" >&2
    echo "    \"$subject\"" >&2
    echo "" >&2
    echo "  CONVENTION (${profile}):" >&2
    echo "    Format:  <type>(<scope>): <subject>" >&2
    echo "    Types:   ${prefixes_hr}" >&2
    echo "    Rules:" >&2
    echo "      - type MUST be one of the above" >&2
    echo "      - colon + space after type (or scope) is MANDATORY" >&2
    echo "      - subject length: ${subject_min}–${subject_max} chars" >&2
    echo "    Examples:" >&2
    echo "      feat: add user registration endpoint" >&2
    echo "      fix(auth): resolve token expiry issue (#3)" >&2
    echo "      chore: update dependencies to latest" >&2
    echo "" >&2
    echo "  RETRY with a corrected message, or bypass: git commit --no-verify" >&2
    echo "" >&2; exit 1
}

reject_ticket() {
    local pat="${custom_pattern:-^[A-Z]+-[0-9]+: .+}"
    echo "" >&2
    echo "[commit-msg] REJECTED — message does not match project conventions." >&2
    echo "" >&2
    echo "  YOUR MESSAGE:" >&2
    echo "    \"$subject\"" >&2
    echo "" >&2
    echo "  CONVENTION (ticket-prefixed):" >&2
    echo "    Format:  <PROJECT-ID>: <subject>" >&2
    echo "    Pattern: ${pat}" >&2
    echo "    Rules:" >&2
    echo "      - must start with uppercase ticket ID (e.g., PROJ-123)" >&2
    echo "      - colon + space after ticket ID is MANDATORY" >&2
    echo "      - subject length: ${subject_min}–${subject_max} chars" >&2
    echo "    Examples:" >&2
    echo "      PROJ-123: fix login timeout" >&2
    echo "      JIRA-456: add search endpoint" >&2
    echo "" >&2
    echo "  RETRY with a corrected message, or bypass: git commit --no-verify" >&2
    echo "" >&2; exit 1
}

reject_gitmoji() {
    echo "" >&2
    echo "[commit-msg] REJECTED — message does not match project conventions." >&2
    echo "" >&2
    echo "  YOUR MESSAGE:" >&2
    echo "    \"$subject\"" >&2
    echo "" >&2
    echo "  CONVENTION (gitmoji):" >&2
    echo "    Format:  :<emoji>: <subject>" >&2
    echo "    Rules:" >&2
    echo "      - must start with a gitmoji shortcode (e.g., :sparkles:)" >&2
    echo "      - space after closing colon is MANDATORY" >&2
    echo "      - subject length: ${subject_min}–${subject_max} chars" >&2
    echo "    Examples:" >&2
    echo "      :sparkles: add new feature" >&2
    echo "      :bug: fix login crash on timeout" >&2
    echo "" >&2
    echo "  RETRY with a corrected message, or bypass: git commit --no-verify" >&2
    echo "" >&2; exit 1
}

reject_custom() {
    echo "" >&2
    echo "[commit-msg] REJECTED — message does not match project conventions." >&2
    echo "" >&2
    echo "  YOUR MESSAGE:" >&2
    echo "    \"$subject\"" >&2
    echo "" >&2
    echo "  CONVENTION (custom):" >&2
    echo "    Pattern: ${custom_pattern}" >&2
    echo "    Rules:" >&2
    echo "      - subject must match the pattern above" >&2
    echo "      - subject length: ${subject_min}–${subject_max} chars" >&2
    echo "" >&2
    echo "  RETRY with a corrected message, or bypass: git commit --no-verify" >&2
    echo "" >&2; exit 1
}

# --- Profile validation ---
case "$profile" in
    conventional-commits|angular)
        if ! echo "$subject" | grep -qE "^(${prefixes})(\([^)]+\))?!?: .+"; then
            reject_conventional
        fi ;;
    ticket-prefixed)
        pattern="${custom_pattern:-^[A-Z]+-[0-9]+[: ] .+}"
        if ! echo "$subject" | grep -qE "$pattern"; then
            reject_ticket
        fi ;;
    gitmoji)
        if ! echo "$subject" | grep -qE "^:[a-z_]+: .+"; then
            reject_gitmoji
        fi ;;
    freeform) ;; # length-only (already checked above)
    *)
        if [ -n "$custom_pattern" ]; then
            if ! echo "$subject" | grep -qE "$custom_pattern"; then
                reject_custom
            fi
        fi ;;
esac

# --- Chain to pre-existing hook ---
USER_HOOK="$(dirname "$0")/commit-msg.user"
[ -x "$USER_HOOK" ] && exec "$USER_HOOK" "$@"
exit 0
